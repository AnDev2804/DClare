# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_NAME=declaraconclara
DB_USER=usuario_de_la_app
DB_PASSWORD=cambie_este_valor

# Sesiones propias de la API
API_SESSION_TTL_DAYS=30

# Recomendado: una ruta absoluta fuera de public_html/www.
MEMBERSHIP_RECEIPT_DIR=/ruta/privada/declaraconclara/membership_receipts

# Solo números, con código de país. Ejemplo Venezuela: 58XXXXXXXXXX
MEMBERSHIP_WHATSAPP_NUMBER=

# IDs OAuth de Android/iOS/Web separados por coma.
GOOGLE_CLIENT_IDS=

